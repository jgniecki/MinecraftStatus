{
    "name": "dev-lancer/minecraft-status",
    "type": "library",
    "description": "PHP library to query Minecraft servers",
    "keywords": ["minecraft", "status", "server", "query", "php", "ping", "bedrock", "raknet"],
    "license": "MIT",
    "authors": [
        {
            "name": "Jakub Gniecki",
            "email": "jgniecki.contact@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-iconv": "*"
    },
    "autoload": {
        "psr-4": {
            "DevLancer\\MinecraftStatus\\": "src/"
        },
        "classmap": [
            "src/MinecraftBedrockStatus.php",
            "src/MinecraftJavaPreOld17Status.php",
            "src/MinecraftJavaQuery.php",
            "src/MinecraftJavaStatus.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "DevLancer\\MinecraftStatus\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.5"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src tests",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "qa": [
            "@cs-check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.1.34"
        }
    }
}
